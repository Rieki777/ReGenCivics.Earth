+            </p>
+          </div>
+          <CitizenshipTierSidebar currentTier={tierName} horizontal className="ml-auto" />
+        </div>
+        <PathPortalsSelector
+          declaredPaths={declared}
+          activePath={activePath}
+          onSelectPath={setActivePath}
+          onAddPath={() => {
