# Human-only private space. Personal notes, drafts, raw transcripts, anything
# not ready to be in the codebase or seen by AI agents. See .human/README.md.
# Pattern: exclude all contents but keep the README so the directory + its
# purpose are visible in version control.
.human/*
!.human/README.md

# Claude Code worktrees (per-session sandboxes; never commit)
.claude/worktrees/

# Personal second-brain vault (Telegram-derived, private, never commit)
second-brain/

# skills CLI (vercel-labs/skills) install artifacts.
# skills-lock.json is committed as the manifest; regenerate the installed
# skills with `npx skills install`. Own project skills in .claude/skills/ stay tracked.
/.agents/
/.claude/skills/find-skills
/.claude/skills/use-railway
/.claude/skills/last30days

# Editor backup files
*.bak

# Generated assets (large source files before R2 upload)
generated/

# CORE church raw image sources (nano-banana-pro output before R2 upload).
# Only the optimized AVIF/WebP on R2 are referenced by the site.
client/public/core/raw/

# CORE sensitive source documents (IRS filings contain SSN + home address).
# NEVER commit these. The public, redacted formation document that the site
# serves lives at client/public/core/formation-document.docx and IS committed.
/CP_575*.pdf
/IRS Application*.pdf
/Church_of_the_Regenerative_Earth_Formation_v2.docx

# Operational debris (untracked 2026-07-01 audit)
credential-replacements.txt
seed_out.txt
seed_err.txt
_tmp_404_*
*.bat
*-log.txt
imports-log.txt

# Elder backfill review artifact (generated, not source)
ELDER_BACKFILL_REVIEW.md

# go-pmtiles binary + extract cache (build artifacts, never commit)
scripts/.bin/
scripts/.cache/

# iOverlander CSV exports: partner data used with permission (personal use +
# people we know). Never commit; lives only on this machine + the production DB.
data/ioverlander/

# A nested, unrelated git repo (~180MB) that lives in this folder. Not part of
# the app; excluded so it stays out of the `railway up` bundle (413 on 2026-07-16).
loomio Governance Tools/

# Kokoro TTS demo clips (research artifacts, not app assets)
voice-demos/

# UI harness screenshots and raw video output (local dev artifacts)
harness/shots/
harness/.out/
video-out/

# Legal research. Rye's own due diligence for conversations with counsel, kept
# out of the repo on purpose: it is working material for a lawyer meeting, not a
# statement of the project's legal position, and a half-formed legal document in
# a public repo is worse than none.
legal-research/
