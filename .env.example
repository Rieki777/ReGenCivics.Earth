# ReGen Civics -- Environment Variables
#
# Copy this file to `.env` and fill in real values before running locally.
# Railway production vars are set in the Railway dashboard, not committed.
#
# Conventions:
#   - VITE_*  -> exposed to the client bundle. Treat as PUBLIC.
#   - everything else -> server only. NEVER prefix a secret with VITE_.
#   - boolean-style flags accept: "true" / "false" / "1" / "0".

# ─── Database (REQUIRED) ─────────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@host:3306/dbname

# ─── Cache (optional) ────────────────────────────────────────────────────────
# Redis URL for the cache layer + tRPC rate-limit. App falls back to in-memory
# limits when unset; only required for production scale.
REDIS_URL=

# ─── Auth (REQUIRED) ─────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=app_session_id
COOKIE_DOMAIN=.regencivics.earth

# ─── Google OAuth (REQUIRED for Google sign-in) ──────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Apple OAuth (optional) ──────────────────────────────────────────────────
APPLE_CLIENT_ID=com.regencivics.app
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=XXXXXXXXXX
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ─── Admin / Owner ───────────────────────────────────────────────────────────
# Run scripts/fix-admin-role.ts after first sign-in to retrieve your sub ID.
OWNER_OPEN_ID=google:your-numeric-google-id
OWNER_EMAIL=your@email.com
RYE_USER_ID=
AUTHOR_USER_ID=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
EMAIL_DOMAIN=regencivics.earth
# EMAIL_REPLY_TO removed 2026-04-27: outgoing email no longer sets a
# Reply-To header. Recipients route through https://regencivics.earth/connect
# so replies surface in admin as form submissions, not inbox emails.
EMAIL_HOLD=false
EMAIL_RATE_LIMIT_PER_HOUR=200
STARTUP_EMAIL_LIMIT=50
TARGET_EMAIL=

# ─── AI / Image Generation ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=
IMAGE_GEN_WORKER_URL=https://your-image-worker.workers.dev
IMAGE_GEN_SECRET=shared-secret-between-server-and-worker

# ─── Google Maps ─────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=AIzaSy...
VITE_GOOGLE_MAPS_API_KEY=AIzaSy...

# ─── Google Calendar / Workspace (optional) ──────────────────────────────────
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# ─── R2 / S3 storage (REQUIRED in production for image uploads) ──────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
AWS_BUCKET_NAME=regen-civics-assets
AWS_ENDPOINT_URL=https://your-account.r2.cloudflarestorage.com
STORAGE_PUBLIC_URL=https://assets.regencivics.earth

# ─── Social broadcasting (optional) ──────────────────────────────────────────
# Buffer scheduler + Farcaster cross-posts.
BUFFER_ACCESS_TOKEN=
FARCASTER_HANDLE=

# ─── Notifications (Telegram + Twilio + WhatsApp, all optional) ──────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─── Analytics (Umami) ───────────────────────────────────────────────────────
VITE_ANALYTICS_WEBSITE_ID=your-umami-website-id
VITE_ANALYTICS_ENDPOINT=https://your-umami-instance.com

# ─── Monitoring (Sentry) ─────────────────────────────────────────────────────
SENTRY_DSN=https://xxxxx@o0.ingest.sentry.io/0
VITE_SENTRY_DSN=https://xxxxx@o0.ingest.sentry.io/0

# ─── Pre-rendering (optional) ────────────────────────────────────────────────
# Used by prerender-node for SEO crawler responses.
PRERENDER_TOKEN=

# ─── Cron / scheduled jobs ───────────────────────────────────────────────────
# Required for /api/cron/* endpoints. Use a strong random string.
CRON_SECRET=change-me-to-a-random-string
ADMIN_WEBHOOK_SECRET=change-me-to-another-random-string

# ─── Riverside webhook (optional) ────────────────────────────────────────────
# Required if Riverside.fm is sending recording-complete callbacks.
RIVERSIDE_WEBHOOK_SECRET=

# ─── Feature flags ───────────────────────────────────────────────────────────
VITE_MAINTENANCE_MODE=false
VITE_ENABLE_SW=true
CAMPAIGN_ACCESS_PASSWORD=

# ─── Hypha / Base chain (Hypha Bridge) ───────────────────────────────────────
# Hypha runs on Base (Coinbase L2, chain ID 8453). The Hypha Bridge module
# (apps/web/src/lib/hypha-bridge/) uses these to pre-fill forms on
# app.hypha.earth and to watch Base for on-chain execution events.
BASE_RPC_URL=https://mainnet.base.org
ALCHEMY_BASE_API_KEY=your-alchemy-base-key
ALCHEMY_WEBHOOK_SIGNING_KEY=your-alchemy-webhook-signing-key
ALCHEMY_HYPHA_WEBHOOK_SIGNING_KEY=
REGEN_TOKEN_ADDRESS_BASE=0x4E617cd113364193d215d107AdD6fa50418AA2E4
RCIVICS_TOKEN_ADDRESS_BASE=0x72e9B17a2F93A923D63666eC0a1c096B1443ef26
REGEN_TOKEN_CONTRACT=0x4E617cd113364193d215d107AdD6fa50418AA2E4
RCIVICS_TOKEN_CONTRACT=0x72e9B17a2F93A923D63666eC0a1c096B1443ef26
RGVOICE_TOKEN_CONTRACT=0x4d848B3f2D74D1D2f6c75c55d0751DAB8FC7D707
RCVOICE_TOKEN_CONTRACT=
HYPHA_DHO_REGEN_GAMES_SLUG=regen-games
HYPHA_DHO_REGEN_CIVICS_SLUG=regen-civics
HYPHA_APP_BASE_URL=https://app.hypha.earth

# ─── Governance subdomain (Loomio) ───────────────────────────────────────────
# gov.regencivics.earth runs Loomio as a sibling service with shared OIDC auth.
# See archive/FORUM_LOOMIO_HYPHA_FLOW_SPEC_2026-04-09.md for full details.
GOVERNANCE_BASE_URL=https://gov.regencivics.earth
LOOMIO_API_URL=https://gov.regencivics.earth
LOOMIO_API_KEY=your-loomio-api-key
LOOMIO_WEBHOOK_HMAC_SECRET=your-loomio-webhook-secret
LOOMIO_GROUP_FUND=
LOOMIO_GROUP_GAME=
OIDC_ISSUER=https://regencivics.earth/api/auth/oidc
OIDC_ISSUER_URL=https://regencivics.earth/api/auth/oidc
OIDC_CLIENT_ID_LOOMIO=loomio-client
OIDC_CLIENT_SECRET_LOOMIO=your-oidc-client-secret
OIDC_LOOMIO_CLIENT_ID=loomio-client
OIDC_LOOMIO_CLIENT_SECRET=your-oidc-client-secret
OIDC_LOOMIO_REDIRECT_URIS=https://gov.regencivics.earth/oidc/callback
OIDC_PRIVATE_KEY_JWK=

# ─── Server / runtime ────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
APP_BASE_URL=http://localhost:5000
APP_URL=http://localhost:5000
PUBLIC_BASE_URL=http://localhost:5000
STAGING_URL=
VITE_APP_ID=regencivics
VITE_APP_URL=http://localhost:5000

# ─── Test / dry-run flags (don't set in production) ──────────────────────────
DRY_RUN=
VITEST=
