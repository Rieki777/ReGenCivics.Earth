# ReGen Civics — Environment Variables
# Copy this file to .env and fill in real values before running locally.
# Railway production vars are set in the Railway dashboard (not committed here).

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@host:3306/dbname

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Apple OAuth (optional) ────────────────────────────────────────────────────
APPLE_CLIENT_ID=com.regencivics.app
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=XXXXXXXXXX
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ── Admin ─────────────────────────────────────────────────────────────────────
# Your Google sub ID — run scripts/fix-admin-role.ts to retrieve it
OWNER_OPEN_ID=google:your-numeric-google-id
OWNER_EMAIL=your@email.com

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_DOMAIN=regencivics.earth
EMAIL_REPLY_TO=hello@regencivics.earth

# ── AI / Image Generation ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
IMAGE_GEN_WORKER_URL=https://your-image-worker.workers.dev
IMAGE_GEN_SECRET=shared-secret-between-server-and-worker

# ── Maps ──────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=AIzaSy...

# ── Social Broadcasting (optional) ────────────────────────────────────────────
# Requires Buffer account — see Fix 2 in FIXES_TO_MAKE_2026-03-11.md
BUFFER_ACCESS_TOKEN=
FARCASTER_HANDLE=

# ── Analytics (Umami) ─────────────────────────────────────────────────────────
VITE_ANALYTICS_WEBSITE_ID=your-umami-website-id
VITE_ANALYTICS_ENDPOINT=https://your-umami-instance.com

# ── Monitoring (Sentry) ───────────────────────────────────────────────────────
SENTRY_DSN=https://xxxxx@o0.ingest.sentry.io/0
VITE_SENTRY_DSN=https://xxxxx@o0.ingest.sentry.io/0

# ── Feature Flags ─────────────────────────────────────────────────────────────
VITE_MAINTENANCE_MODE=false
VITE_ENABLE_SW=true

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
VITE_APP_ID=regencivics
