# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@host:3306/dbname

# ─── Auth / Session ──────────────────────────────────────────────────────────
JWT_SECRET=your-random-secret-here-generate-with-openssl-rand-base64-32
OWNER_OPEN_ID=google:your-google-user-id   # Your own user ID (becomes admin)
VITE_APP_ID=regen-civics

# ─── App URL (no trailing slash) ─────────────────────────────────────────────
APP_URL=https://yourdomain.com

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Apple OAuth ─────────────────────────────────────────────────────────────
# Get from: https://developer.apple.com → Certificates, Identifiers & Profiles
APPLE_CLIENT_ID=com.yourapp.service-id
APPLE_TEAM_ID=YOURTEAMID
APPLE_KEY_ID=YOURKEYID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Get from: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
OWNER_EMAIL=you@yourdomain.com
EMAIL_DOMAIN=yourdomain.com

# ─── File Storage (Cloudflare R2 or AWS S3) ──────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_BUCKET_NAME=regen-civics-assets
AWS_REGION=auto                         # use "auto" for Cloudflare R2, or e.g. "us-east-1" for AWS
AWS_ENDPOINT_URL=https://xxxx.r2.cloudflarestorage.com   # R2 endpoint (omit for standard AWS S3)
STORAGE_PUBLIC_URL=https://assets.yourdomain.com         # Public CDN base URL for uploaded files

# ─── Google Maps (optional — only needed if using the /map page) ──────────────
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Error Tracking (Sentry) — optional ─────────────────────────────────────
# Get from: https://sentry.io → Project → Settings → Client Keys (DSN)
SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx
VITE_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx

# ─── AI (Anthropic Claude) ───────────────────────────────────────────────────
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# ─── Base Blockchain (read-only RPC) ─────────────────────────────────────────
# Base RPC URL (defaults to public endpoint)
BASE_RPC_URL=https://mainnet.base.org

# Token contract addresses on Base mainnet
RGVOICE_TOKEN_CONTRACT=0x4d848b3f2d74d1d2f6c75c55d0751dab8fc7d707
REGEN_TOKEN_CONTRACT=0x4e617cd113364193d215d107add6fa50418aa2e4

# ─── Social Broadcasting (Buffer) ─────────────────────────────────────────────
# Get from: https://buffer.com/developers/api
BUFFER_ACCESS_TOKEN=your_buffer_access_token_here

# ─── Farcaster ────────────────────────────────────────────────────────────────
# Display only, used for reference. Posting uses Warpcast intent links (no API key needed).
FARCASTER_HANDLE=@handle.eth

# ─── Maintenance Mode ─────────────────────────────────────────────────────────
# Set to 'true' in Railway env vars before risky deploys (schema migrations, etc.)
# Toggle back to 'false' (or remove) when done. Takes effect on next build/redeploy.
VITE_MAINTENANCE_MODE=false
