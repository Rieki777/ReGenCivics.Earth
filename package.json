  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "validate:html": "node scripts/validate-html.mjs",
    "build": "node scripts/validate-html.mjs && node scripts/check-unoptimized-images.mjs && tsc --noEmit && vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && node scripts/prerender-blog.mjs",
    "check:images": "node scripts/check-unoptimized-images.mjs",
    "check:colors": "node scripts/check-hardcoded-colors.mjs",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "check:palette": "tsx scripts/check-palette.ts",
    "check:palette:warn": "tsx scripts/check-palette.ts --warn-only",
    "lint": "eslint . --max-warnings=1000",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run --exclude \"**/node_modules/**\" --exclude \"**/dist/**\" --exclude \"server/applications.test.ts\" --exclude \"server/forum.test.ts\" --exclude \"server/citizenship-tiers.test.ts\" --exclude \"server/notification-prefs.test.ts\" --exclude \"server/loi.test.ts\" --exclude \"server/forms.test.ts\" --exclude \"server/contributions.test.ts\" --exclude \"server/emoji-reactions.test.ts\" --exclude \"server/email-features.test.ts\"",
    "test:integration": "vitest run server/applications.test.ts server/forum.test.ts server/citizenship-tiers.test.ts server/notification-prefs.test.ts server/loi.test.ts server/forms.test.ts server/contributions.test.ts server/emoji-reactions.test.ts server/email-features.test.ts",
    "test:all": "vitest run",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "sync:quest-content": "tsx scripts/sync-quest-content.ts",
    "seed:forum": "tsx scripts/seed-forum-posts.ts",
    "seed:forum:reset": "tsx scripts/seed-forum-posts.ts --reset",
    "seed:seeds": "tsx scripts/seed-seeds-contributions.ts",
    "seed:seeds:reset": "tsx scripts/seed-seeds-contributions.ts --reset",
    "optimize:images": "node scripts/optimize-images.mjs",
    "db:migrate": "tsx scripts/run-migration.ts",
    "db:migrate:all": "tsx scripts/run-migration.ts --all",
    "db:migrate:status": "tsx scripts/run-migration.ts --status"
  },
