{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "regen-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "regen-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "NODE_ENV=production",
        "PORT=3100",
        "APP_URL=http://localhost:3100",
        "node",
        "dist/index.js"
      ],
      "port": 3100
    }
  ]
}
