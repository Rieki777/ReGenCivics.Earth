# Block postinstall + preinstall scripts from running on `pnpm install`. This
# is the primary supply-chain hardening: a malicious package version cannot
# execute arbitrary code on install. Trade-off: legitimate packages that
# need a postinstall (rare in our deps) will need explicit allowlisting via
# `pnpm approve-builds` or `--allow-build`. As of 2026-04-25 nothing in our
# tree needs it.
ignore-scripts=true

# Enforce the Node version pinned in `.nvmrc` / `.node-version` / package.json
# `engines.node`. Without this, a contributor on a different Node version
# could `pnpm install` against an incompatible engine and ship a build that
# only worked locally. Set in lockstep with Railway's Node version.
engine-strict=true

# Prefer offline cache for repeat installs. Speeds up CI + lockfile-only
# changes without sacrificing reproducibility (frozen lockfile still wins).
prefer-offline=true
