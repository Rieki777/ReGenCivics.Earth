# The shared secret between the ReGen Civics server and this worker.
# Set the SAME value as TRANSCRIPTION_API_KEY on the ReGenCivics.Earth service.
WORKER_API_KEY=change-me-to-a-long-random-string

# Backend selection. Leave TRANSCRIBE_BACKEND unset to auto-pick:
#   GROQ_API_KEY present   -> groq
#   OPENAI_API_KEY present -> openai
#   neither                -> local faster-whisper (free, no per-minute cost)
# TRANSCRIBE_BACKEND=local

# Local faster-whisper model size: tiny | base | small | medium | large-v3
# Bigger is more accurate and slower. base is a good default on CPU.
WHISPER_MODEL=base

# Optional hosted backends (pick one if you want speed over free/local):
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...

# Optional: path to a yt-dlp cookies.txt for login- or age-gated videos.
# YTDLP_COOKIES_FILE=/app/cookies.txt
